# CloudBase AI. Production cloud functions use the environment's temporary credentials automatically.
CLOUDBASE_ENV_ID=replace-with-your-cloudbase-env-id
CLOUDBASE_AI_PROVIDER=cloudbase
CLOUDBASE_AI_MODEL=hy3

# Only required when running the legacy local Node API or provider checks outside CloudBase.
TENCENT_SECRET_ID=replace-with-local-secret
TENCENT_SECRET_KEY=replace-with-local-secret

# Local API and AI runtime
API_HOST=127.0.0.1
API_PORT=8787
AI_TIMEOUT_MS=55000
AI_MAX_OUTPUT_TOKENS=6000
REVIEW_TTL_MS=1800000
